<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Donanım özellikleri (Play Store filtre + şeffaflık) ──────────
         required="false" → kamera/BT/GPS olmayan cihazlara da yüklenir.
         Uygulama bu donanımları OKUMA AMAÇLI kullanır, kontrol etmez.
    ─────────────────────────────────────────────────────────────────── -->
    <uses-feature android:name="android.hardware.camera"            android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus"  android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth"         android:required="false" />
    <uses-feature android:name="android.hardware.location"          android:required="false" />
    <uses-feature android:name="android.hardware.location.gps"      android:required="false" />
    <uses-feature android:name="android.hardware.microphone"        android:required="false" />
    <!-- USB Host — CAN bus USB-to-serial adaptörleri (CH340, CP2102, FTDI, CDC ACM) -->
    <uses-feature android:name="android.hardware.usb.host"         android:required="false" />

    <!-- ── Sorgu bildirimleri (API 30+ paket görünürlüğü) ─────────────── -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="sms" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/AppTheme">

        <!-- ── Ana Activity ─────────────────────────────────────────────── -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing"
            android:immersive="true"
            android:excludeFromRecents="false"
            android:alwaysRetainTaskState="true"
            android:showOnLockScreen="true">

            <!-- Launcher + Home ekranı olarak kaydet -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- USB serial cihaz bağlandığında otomatik başlat + izin iste -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>

            <!-- carospro://auth/* Deep Link — şifre sıfırlama ve admin auth -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="carospro" android:host="auth" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />

        </activity>

        <!-- ── Boot receiver: cihaz açıldığında launcher'ı başlat ────── -->
        <!-- priority="1000": diğer receiver'lardan önce çalışsın       -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- API 24+ şifreli cihazlar — Direct Boot -->
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <!-- HTC / Xiaomi ve bazı OEM head unit ROM'ları.
                     ⚠️ Bu action AOSP'de PROTECTED BROADCAST DEĞİLDİR → üçüncü taraf
                     uygulama sahte yollayabilir. BootReceiver.isAcceptedBootAction()
                     bunu yalnız gerçek açılış penceresinde (QUICKBOOT_MAX_UPTIME_MS)
                     kabul eder; pencere dışında REDDEDİLİR. Receiver'a permission
                     KONULMAZ: o gönderenin izne sahip olmasını şart koşar ve QUICKBOOT'u
                     yollayan OEM bileşeni sistem uid'i olmayabilir → meşru açılış sessizce
                     kaybolurdu. Bu filtreden action'ı kaldırmak, yalnız hızlı-açılış
                     yayını üreten head unit'lerde otomatik başlatmayı BOZAR. -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- ── Arka plan GPS + mola hatırlatıcısı Foreground Service ─────
             location foregroundServiceType gerektirir.
             Android 12+'de kullanıcı konum iznini ön planda vermeli.
        ──────────────────────────────────────────────────────────────── -->
        <service
            android:name=".CarLauncherForegroundService"
            android:foregroundServiceType="location"
            android:exported="false"
            android:stopWithTask="false" />

        <!-- ── Media oturumu okuma için NotificationListenerService ─────
             Kullanıcı Ayarlar → Bildirim Erişimi → CockpitOS'u
             etkinleştirdiğinde bu servis bağlanır ve MediaSessionManager
             üzerinden aktif medya oturumuna erişim sağlar.
        ──────────────────────────────────────────────────────────────── -->
        <service
            android:name=".MediaListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- ── MÜZİK HUB PAKET A: Tek Automotive Playback Authority ─────
             CarosPlaybackService = uygulamanın TEK sesli oynatma otoritesi
             (Media3 ExoPlayer + MediaSession). Bildirim kontrolleri, kilit
             ekranı, Bluetooth AVRCP, direksiyon/kulaklık medya tuşları ve
             UI/Mavi komutları AYNI otoriteye gider.

             exported="true" ZORUNLUDUR: MediaSessionService'e sistem medya
             kontrolleri (bildirim paneli, kilit ekranı, AVRCP router) bind
             eder; false olsaydı donanım medya tuşları uygulamaya HİÇ ulaşmazdı.
             Güvenlik kapısı kodda: CarosPlaybackService.onConnect() yalnızca
             (a) kendi paketimize ve (b) Android'in "trusted" saydığı sistem
             controller'larına bağlantı verir; yabancı paketler REDDEDİLİR.
             Servis harici Intent extra'sı OKUMAZ (intent spoofing yüzeyi yok).
        ──────────────────────────────────────────────────────────────── -->
        <service
            android:name=".media.CarosPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- ── H-4 Native Command Service: FCM arka plan komut alıcısı ─
             WebView kapalıyken FCM push alır, MCU komutlarını doğrudan
             CanBusManager üzerinden çalıştırır. E2E şifre çözme için
             NativeCryptoManager (ECDH-P256 + HKDF-SHA256 + AES-GCM).
        ──────────────────────────────────────────────────────────────── -->
        <service
            android:name=".CommandService"
            android:exported="false"
            android:stopWithTask="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- ── CommandService local broadcast receiver ───────────────── -->
        <receiver
            android:name=".CommandBroadcastReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.cockpitos.pro.COMMAND_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- ── FileProvider (dashcam, çekim kayıtları için) ─────────── -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

    <!-- ══════════════════════════════════════════════════════════════════
         İZİNLER
         ══════════════════════════════════════════════════════════════ -->

    <!-- Android 13+ (API 33) — bildirim gönderme izni (POST_NOTIFICATIONS) -->
    <!-- NotificationListenerService izin sayfasının kısıtlanmış ayar hatası vermemesi için gerekli -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        android:minSdkVersion="33" />

    <!-- Temel ağ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Cihaz boot & ekran kilidi -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- GPS / Konum -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Arka planda GPS (dashcam + trip log için) -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Bluetooth — OBD ELM327 bağlantısı -->
    <!-- API < 31 -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <!-- API 31+ -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- neverForLocation KALDIRILDI: Classic BT discovery (ACTION_FOUND) eşli
         OLMAYAN OBD adaptörlerini ancak konum çıkarımına izin verildiğinde
         bildirir. Flag kalsaydı sadece bonded cihazlar listelenirdi. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <!-- Mikrofon — sesli asistan -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Kamera — geri görüş kamerası -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Kişiler — Android rehber senkronizasyonu -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Arama başlatma — "annemi ara" sesli komutu.
         NEDEN GEREKLİ: bu izin OLMADAN yalnız ACTION_DIAL kullanılabilir ve o da
         çeviriciyi numarayla AÇAR, aramayı BAŞLATMAZ. Sürüş sırasında kullanıcının
         ekrana uzanıp arama tuşuna basması gerekiyordu — sesli komutun amacı buydu.
         İzin yoksa davranış ACTION_DIAL'a düşer ve asistan bunu DÜRÜSTÇE söyler
         (sahte "aranıyor" onayı YOK — bkz. CarLauncherPlugin.callNumber). -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Depolama — dashcam kayıtları + cihaz-içi API anahtarı yedeği -->
    <!-- API 29 ve altı (requestLegacyExternalStorage ile API 29 dahil legacy davranış) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- API 33+ (Android 13) — granular media permissions -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- READ_MEDIA_IMAGES KALDIRILDI (P0.5-A, least-privilege): kod tarafında hiçbir
         MediaStore.Images tüketicisi yok; medya tarayıcı yalnız Audio + Video okur. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- API 30+ (Android 11+) — Tüm Dosyalara Erişim: cihaz-içi API anahtarı
         yedeği uninstall'da silinmeyen paylaşımlı depoya yazılır. Uygulama
         Play Store'da değil (B2B sideload) — policy riski yok. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Sistem ayarları — ekran parlaklığı (WRITE_SETTINGS) -->
    <!-- Uygulama normal WRITE_SETTINGS talep edebilir;
         Android, kullanıcıyı özel izin ekranına yönlendirir -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Ön plan servisi — arka planda GPS/dashcam -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- MÜZİK HUB PAKET A — Android 14 (API 34+) foregroundServiceType="mediaPlayback"
         bu izin olmadan SecurityException fırlatır; müzik arka planda susardı. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Pil optimizasyonu muafiyeti — MIUI/HyperOS arka plan öldürmesini önler -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- OTA v1 (Commit 5): hash+imza dogrulanmis guncelleme APK'sinin sistem
         kurulum ekranini acabilmesi icin. SESSIZ KURULUM YOK - kullanici onayi
         her zaman Android sistem diyalogunda (OtaInstallManager.java kapisi:
         paket/surum/imza on-kontrolu gecmeden bu izin kullanilmaz). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

</manifest>
