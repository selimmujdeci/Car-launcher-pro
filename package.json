{
  "name": "cockpitos",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build:sw": "tsc src/serviceWorker.ts --outDir public --target ES2020 --lib ES2020,WebWorker --strict --skipLibCheck",
    "build": "npm run build:sw && node scripts/copy-sqljs-wasm.mjs && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "cap:sync": "npm run build && npx cap sync",
    "cap:copy": "npm run build && npx cap copy",
    "test:rls": "node scripts/run-db-matrix.mjs supabase/tests/063_rls_exposure_matrix.sql \"4 KAPI DA GECTI\"",
    "test:retention": "node scripts/run-db-matrix.mjs supabase/tests/065_retention_policy_matrix.sql \"4 HALKA DA GECTI\"",
    "test:apikey": "node scripts/run-db-matrix.mjs supabase/tests/066_company_api_key_matrix.sql \"6 HALKA DA GECTI\"",
    "test:schedule": "node scripts/run-db-matrix.mjs supabase/tests/067_report_schedule_matrix.sql \"6 HALKA DA GECTI\"",
    "test:dna": "node scripts/run-db-matrix.mjs supabase/tests/064_driver_dna_chain_matrix.sql \"6 HALKA DA GECTI\"",
    "test:rls:prod": "node scripts/run-prod-rls-probe.mjs",
    "guard": "vitest run src/__tests__/regression.guards.test.ts",
    "compat:verify": "node scripts/verify-webview-compat.mjs",
    "apk:safe": "npm run test && npm run build && npm run compat:verify && npx cap sync android && node scripts/gradle-build.mjs clean assembleDebug",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "test:all": "vitest run && vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "setup:e2e": "playwright install --with-deps chromium",
    "fetch:vosk": "node scripts/fetch-vosk-model.mjs",
    "release:bump": "node scripts/bump-version.mjs",
    "release:apk": "npm run build && npx cap sync android && node scripts/gradle-build.mjs assembleRelease",
    "release:aab": "npm run build && npx cap sync android && node scripts/gradle-build.mjs bundleRelease",
    "ota:publish": "node scripts/publish-ota.mjs",
    "test:identity": "node scripts/run-db-matrix.mjs supabase/tests/069_p0_001a_identity_matrix.sql \"6 HALKA DA GECTI\"",
    "test:e2ekey": "node scripts/run-db-matrix.mjs supabase/tests/070_e2e_key_publish_matrix.sql \"7 HALKA DA GECTI\""
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.2.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/geolocation": "^7.0.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.104.0",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^4.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-router-dom": "^7.18.3",
    "sql.js": "^1.14.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@maplibre/maplibre-gl-style-spec": "^20.4.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "regenerator-runtime": "^0.14.1",
    "terser": "^5.51.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.2"
  }
}
